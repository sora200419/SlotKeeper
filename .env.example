# Copy to .env.local and fill in. Never commit .env.local.
# Values come from developer.paypal.com > Apps & Credentials (Sandbox).

# sandbox | production  (this project stays on sandbox)
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Public: safe in the browser (JS SDK v6 uses it).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Private: server only. Never prefix with NEXT_PUBLIC_.
PAYPAL_CLIENT_SECRET=

# Optional: per-request timeout for PayPal calls in ms (default 15000).
# PAYPAL_TIMEOUT_MS=15000

# Safety catch: production is refused unless this is exactly "true". Leave it unset.
# PAYPAL_ALLOW_PRODUCTION=false

# Private: shared secret for staff money actions (capture / void / reauthorize / refund).
# Send it as "Authorization: Bearer <token>". Leave empty to keep those routes disabled.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_API_TOKEN=

# Optional: public base URL for PayPal return/cancel links (set this when deployed).
# APP_URL=https://slotkeeper.example.com
