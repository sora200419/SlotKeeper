# Copy to .env.local and fill in. Never commit .env.local.
# Values come from developer.paypal.com > Apps & Credentials (Sandbox).

# sandbox | production  (this project stays on sandbox)
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Public: safe in the browser (JS SDK v6 uses it).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Private: server only. Never prefix with NEXT_PUBLIC_.
PAYPAL_CLIENT_SECRET=

# Optional: per-request timeout for PayPal calls in ms (default 15000, max 60000).
# PAYPAL_TIMEOUT_MS=15000

# Safety catch: production is refused unless this is exactly "true". Leave it unset.
# PAYPAL_ALLOW_PRODUCTION=false

# Private: shared secret for staff money actions (capture / void / reauthorize / refund).
# Send it as "Authorization: Bearer <token>". Leave empty to keep those routes disabled.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_API_TOKEN=

# Webhook ID from developer.paypal.com > Apps & Credentials > your app > Webhooks (sandbox).
# Needed to verify POST /api/webhooks/paypal; without it every delivery is refused (500).
PAYPAL_WEBHOOK_ID=

# End-of-day payouts: where each staff member is paid (sandbox personal account emails).
# Staff without an entry are skipped and reported. Example: maria=maria@personal.example.com,ken=ken@personal.example.com
STAFF_PAYOUT_EMAILS=

# Optional: IANA time zone that decides the business day for payouts (default UTC).
# BUSINESS_TIME_ZONE=America/Los_Angeles

# Optional: public base URL for PayPal return/cancel links (set this when deployed).
# APP_URL=https://slotkeeper.example.com
